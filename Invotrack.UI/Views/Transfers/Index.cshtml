@model IEnumerable<Invotrack.Domain.Entities.StockMovement>
@{
    ViewData["Title"] = "تقرير تحويلات المخازن";
}

<div class="d-flex justify-content-between align-items-center mb-4" dir="rtl">
    <div>
        <h3 class="fw-bold text-dark mb-0">تقرير حركات التحويل بين المخازن</h3>
        <small class="text-muted">تتبع تفصيلي لكافة أذونات التحويل الصادرة والواردة</small>
    </div>
    <a asp-action="Create" class="btn btn-primary px-3 shadow-sm"><i class="bi bi-plus-lg me-1"></i> إجراء تحويل جديد</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" dir="rtl" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card card-custom p-3" dir="rtl">
    <div class="table-responsive">
        <table class="table table-hover align-middle text-center mb-0">
            <thead class="table-light">
                <tr>
                    <th>تاريخ الحركة</th>
                    <th>رقم المستند</th>
                    <th>الصنف</th>
                    <th>من مخزن</th>
                    <th>إلى مخزن</th>
                    <th>الكمية المحولة</th>
                    <th>المسؤول</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td><span class="badge bg-secondary">@item.DocumentNo</span></td>
                            <td class="fw-bold">@item.Product?.NameAr</td>
                            <td><span class="badge bg-danger-subtle text-danger">@item.SourceWarehouse?.Name</span></td>
                            <td><span class="badge bg-success-subtle text-success">@item.DestinationWarehouse?.Name</span></td>
                            <td><span class="fs-6 fw-bold text-primary">@item.Quantity</span></td>
                            <td>@item.CreatedBy</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-muted py-4">لا توجد حركات تحويل مسجلة حالياً.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>