@model Invotrack.Application.DTOs.CategoryDto
@{
    ViewData["Title"] = "تعديل التصنيف";
}

<div class="row justify-content-center" dir="rtl">
    <div class="col-md-6">
        <div class="card card-custom p-4 shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold text-dark mb-0"><i class="bi bi-pencil-square me-2 text-warning"></i>تعديل بيانات التصنيف</h4>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-right"></i> إلغاء وعودة</a>
            </div>

            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="NameAr" class="form-label fw-bold">الاسم بالعربية</label>
                    <input asp-for="NameAr" class="form-control" required />
                    <span asp-validation-for="NameAr" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="NameEn" class="form-label fw-bold">English Name</label>
                    <input asp-for="NameEn" class="form-control" required />
                    <span asp-validation-for="NameEn" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-warning btn-lg w-100 fw-bold shadow-sm"><i class="bi bi-save me-1"></i> حفظ التعديلات</button>
            </form>
        </div>
    </div>
</div>