@{
    ViewData["Title"] = "عفواً - غير مسموح بالوصول";
}

<div class="d-flex align-items-center justify-content-center" style="min-height: 70vh;" dir="rtl">
    <div class="text-center p-5 bg-white rounded-4 shadow-sm border" style="max-width: 500px;">
        <!-- أيقونة التنبيه -->
        <div class="mb-4">
            <div class="d-inline-flex align-items-center justify-content-center bg-danger-subtle text-danger rounded-circle p-4" style="width: 90px; height: 90px;">
                <i class="bi bi-shield-lock-fill fs-1"></i>
            </div>
        </div>

        <!-- نص الرسالة -->
        <h4 class="fw-bold text-dark mb-2">صلاحيات غير كافية</h4>
        <p class="text-muted mb-4 fs-6">
            عفواً، ليس لديك الصلاحية المطلوبة للوصول إلى هذه الصفحة أو تنفيذ هذا الإجراء. يُرجى مراجعة مدير النظام إذا كنت تعتقد أن هذا خطأ.
        </p>

        <!-- أزرار التنقل -->
        <div class="d-flex justify-content-center gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 fw-bold">
                <i class="bi bi-house-door-fill me-1"></i> العودة للرئيسية
            </a>
        </div>
    </div>
</div>