@model Invotrack.Application.DTOs.StockOutDto
@{
    ViewData["Title"] = "إذن صرف مخزني";
}

<div class="row justify-content-center" dir="rtl">
    <div class="col-md-7">
        <div class="card card-custom p-4 shadow-sm">
            <h4 class="fw-bold text-dark mb-3"><i class="bi bi-box-arrow-up me-2 text-danger"></i>إذن صرف مخزني (صادر)</h4>
            <form asp-action="StockOut" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label class="form-label fw-bold">اختر الصنف المنصرف</label>
                    <select asp-for="ProductId" class="form-select" asp-items="@(new SelectList(ViewBag.Products, "Id", "NameAr"))">
                        <option value="">-- اختر الصنف --</option>
                    </select>
                    <span asp-validation-for="ProductId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">المخزن المنصرف منه</label>
                    <select asp-for="WarehouseId" class="form-select" asp-items="@(new SelectList(ViewBag.Warehouses, "Id", "Name"))">
                        <option value="">-- اختر المخزن --</option>
                    </select>
                    <span asp-validation-for="WarehouseId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">الكمية المنصرفة</label>
                    <input asp-for="Quantity" type="number" class="form-control" min="1" required />
                    <span asp-validation-for="Quantity" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">جهة الصرف / العميل / المشروع</label>
                    <input asp-for="Note" class="form-control" placeholder="مثال: مشروع البرج السكني / العميل أحمد" />
                    <span asp-validation-for="Note" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-danger btn-lg w-100 fw-bold shadow-sm"><i class="bi bi-check-lg me-1"></i> اعتماد وحفظ إذن الصرف</button>
            </form>
        </div>
    </div>
</div>