@model IEnumerable<Invotrack.Application.DTOs.UserListDto>
@{
    ViewData["Title"] = "إدارة المستخدمين والصلاحيات";
}

<div class="d-flex justify-content-between align-items-center mb-4" dir="rtl">
    <div>
        <h3 class="fw-bold text-dark mb-0"><i class="bi bi-people-fill me-2 text-primary"></i>إدارة المستخدمين والصلاحيات</h3>
        <small class="text-muted">التحكم في أدوار وصلاحيات حسابات موظفي النظام</small>
    </div>
    <a asp-action="Create" class="btn btn-primary px-3 shadow-sm"><i class="bi bi-person-plus-fill me-1"></i> إضافة مستخدم جديد</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" dir="rtl">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card card-custom p-3" dir="rtl">
    <div class="table-responsive">
        <table class="table table-hover align-middle text-center mb-0">
            <thead class="table-light">
                <tr>
                    <th>اسم الموظف</th>
                    <th>البريد الإلكتروني</th>
                    <th>الدور / الصلاحية</th>
                    <th>حالة الحساب</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-dark">@item.FullName</td>
                            <td>@item.Email</td>
                            <td><span class="badge bg-primary fs-6">@item.RoleName</span></td>
                            <td>
                                <span class="badge @(item.IsActive ? "bg-success" : "bg-danger") fs-6">
                                    @(item.IsActive ? "نشط" : "معطل")
                                </span>
                            </td>
                            <td>
                                <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                        <i class="bi @(item.IsActive ? "bi-slash-circle" : "bi-check-circle") me-1"></i>
                                        @(item.IsActive ? "تعطيل الحساب" : "تنشيط الحساب")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-muted py-4">لا يوجد مستخدمون مسجلون حالياً.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>