@model IEnumerable<Invotrack.Application.DTOs.InventoryValuationDto>
@{
    ViewData["Title"] = "تقرير التقييم المالي للمخزون";
    var totalCost = Model.Sum(x => x.TotalCostValue);
    var totalSale = Model.Sum(x => x.TotalSaleValue);
    var expectedProfit = totalSale - totalCost;
}

<div class="d-flex justify-content-between align-items-center mb-4" dir="rtl">
    <div>
        <h3 class="fw-bold text-dark mb-0"><i class="bi bi-bar-chart-line-fill me-2 text-primary"></i>تقرير التقييم المالي الشامل</h3>
        <small class="text-muted">متابعة الأرباح المتوقعة ورأس المال المستثمر في البضائع</small>
    </div>
    <a asp-action="ExportValuationToExcel" class="btn btn-success px-3 shadow-sm">
        <i class="bi bi-file-earmark-excel me-1"></i> تصدير لـ Excel
    </a>
</div>

<!-- بطاقات إحصائية مالية (KPI Cards) -->
<div class="row g-3 mb-4" dir="rtl">
    <div class="col-md-4">
        <div class="card card-custom p-3 border-start border-primary border-4">
            <span class="text-muted fw-semibold">إجمالي رأس المال بالمخازن (التكلفة)</span>
            <h3 class="fw-bold text-primary my-1">@totalCost.ToString("N2") ج.م</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-custom p-3 border-start border-success border-4">
            <span class="text-muted fw-semibold">القيمة البيعية المتوقعة</span>
            <h3 class="fw-bold text-success my-1">@totalSale.ToString("N2") ج.م</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-custom p-3 border-start border-info border-4">
            <span class="text-muted fw-semibold">إجمالي الأرباح المتوقعة</span>
            <h3 class="fw-bold text-info my-1">@expectedProfit.ToString("N2") ج.م</h3>
        </div>
    </div>
</div>

<!-- جدول التقييم التفصيلي -->
<div class="card card-custom p-3" dir="rtl">
    <div class="table-responsive">
        <table class="table table-hover align-middle text-center mb-0">
            <thead class="table-light">
                <tr>
                    <th>SKU</th>
                    <th>اسم الصنف</th>
                    <th>الكمية الإجمالية</th>
                    <th>تكلفة الشراء</th>
                    <th>سعر البيع</th>
                    <th>إجمالي التكلفة</th>
                    <th>إجمالي البيع</th>
                    <th>الربح المتوقع</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@item.SKU</td>
                        <td class="fw-bold text-dark">@item.ProductName</td>
                        <td><span class="badge bg-secondary fs-6">@item.TotalQuantity</span></td>
                        <td>@item.CostPrice.ToString("N2") ج.م</td>
                        <td>@item.SalePrice.ToString("N2") ج.م</td>
                        <td class="table-warning font-monospace">@item.TotalCostValue.ToString("N2") ج.م</td>
                        <td class="table-success font-monospace">@item.TotalSaleValue.ToString("N2") ج.م</td>
                        <td class="fw-bold text-primary font-monospace">@item.ExpectedProfit.ToString("N2") ج.م</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>