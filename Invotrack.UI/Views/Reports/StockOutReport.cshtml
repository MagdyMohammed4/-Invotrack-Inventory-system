@model IEnumerable<Invotrack.Application.DTOs.StockReportItemDto>
@{
    ViewData["Title"] = "تقرير المخزون الصادر والمنصرف";
    var totalQty = ViewBag.TotalOutQuantity ?? 0;
}

<div dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-0">
                <i class="bi bi-box-arrow-up me-2 text-danger"></i> تقرير عمليات المخزون الصادر (Stock-Out)
            </h3>
            <small class="text-muted">متابعة أذونات الصرف والتوزيع مع كافة التفاصيل والتواريخ</small>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3 shadow-sm">
            <i class="bi bi-arrow-right me-1"></i> العودة للتقارير
        </a>
    </div>

    <!-- كارت الفلترة وتصفية التاريخ -->
    <div class="card card-custom p-3 mb-4 shadow-sm">
        <form asp-action="StockOutReport" method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label fw-bold small">من تاريخ</label>
                <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold small">إلى تاريخ</label>
                <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control" />
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-danger fw-bold flex-fill"><i class="bi bi-filter me-1"></i> تصفية الصادر</button>
                <a asp-action="StockOutReport" class="btn btn-light border"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>

    <!-- ملخص الرقم المنصرف -->
    <div class="alert alert-danger d-flex justify-content-between align-items-center mb-4" style="border-radius: 10px;">
        <span class="fw-bold"><i class="bi bi-info-circle me-1"></i> إجمالي الكميات المنصرفة خلال الفترة المحددة:</span>
        <span class="badge bg-danger fs-5">@totalQty.ToString("N0") وحدة</span>
    </div>

    <!-- جدول عمليات الصادر -->
    <div class="card card-custom p-3 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle text-center mb-0">
                <thead class="table-light">
                    <tr>
                        <th>رقم المستند</th>
                        <th>التاريخ والوقت</th>
                        <th>المنتج / الصنف</th>
                        <th>المستودع المنصرف منه</th>
                        <th>العميل / الشريك</th>
                        <th>الكمية المنصرفة</th>
                        <th>نوع الإذن</th>
                        <th>المسؤول</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold text-primary">@(string.IsNullOrEmpty(item.DocumentNo) ? $"OUT-{item.Id:D5}" : item.DocumentNo)</td>
                                <td>@item.Date.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="fw-bold text-start">@item.ProductName</td>
                                <td><span class="badge bg-light text-dark border">@item.SourceWarehouseName</span></td>
                                <td class="text-secondary">@item.PartnerName</td>
                                <td class="fw-bold text-danger fs-6">-@item.Quantity.ToString("N0")</td>
                                <td><span class="badge bg-danger-subtle text-danger border border-danger-subtle">@item.MovementTypeName</span></td>
                                <td class="small text-muted">@item.CreatedBy</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-muted py-4">لا توجد عمليات صرف مسجلة ضمن الفترة المحددة.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>