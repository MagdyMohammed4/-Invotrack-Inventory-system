@model IEnumerable<Invotrack.Application.DTOs.ProductDto>
@{
    ViewData["Title"] = "تقرير المخزون الحالي والأرصدة المتاحة";
    var totalUnits = Model?.Sum(p => p.TotalStock) ?? 0;
    var totalCostValue = Model?.Sum(p => p.TotalStock * p.CostPrice) ?? 0;
    var totalSalesValue = Model?.Sum(p => p.TotalStock * p.SalePrice) ?? 0;
}

<div dir="rtl">
    <!-- الهيدر والعمليات السريعة -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-0">
                <i class="bi bi-box-seam me-2 text-primary"></i> تقرير حالة المخزون الحالي والأرصدة
            </h3>
            <small class="text-muted">متابعة أرصدة المنتجات المتاحة، حد الأمان والقيم المالية الإجمالية</small>
        </div>
        <div class="d-flex gap-2">
            <button onclick="window.print()" class="btn btn-outline-dark btn-sm shadow-sm fw-bold">
                <i class="bi bi-printer me-1"></i> طباعة التقرير
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3 shadow-sm">
                <i class="bi bi-arrow-right me-1"></i> العودة للتقارير
            </a>
        </div>
    </div>

    <!-- ملخص الممتلكات بالمخزن -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card card-custom p-3 border-start border-primary border-4 shadow-sm">
                <small class="text-muted fw-bold">إجمالي كمية المخزون المتاح</small>
                <h4 class="fw-bold text-primary mb-0">@totalUnits.ToString("N0") <small class="fs-6 text-dark">وحدة</small></h4>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-custom p-3 border-start border-success border-4 shadow-sm">
                <small class="text-muted fw-bold">القيمة التقديرية بسعر التكلفة</small>
                <h4 class="fw-bold text-success mb-0">@totalCostValue.ToString("N2") <small class="fs-6 text-dark">ج.م</small></h4>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-custom p-3 border-start border-info border-4 shadow-sm">
                <small class="text-muted fw-bold">القيمة التقديرية بسعر البيع</small>
                <h4 class="fw-bold text-info mb-0">@totalSalesValue.ToString("N2") <small class="fs-6 text-dark">ج.م</small></h4>
            </div>
        </div>
    </div>

    <!-- جدول المخزون الحالي -->
    <div class="card card-custom p-3 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle text-center mb-0">
                <thead class="table-light">
                    <tr>
                        <th>رمز الصنف (SKU)</th>
                        <th>اسم المنتج</th>
                        <th>الفئة / التصنيف</th>
                        <th>الرصيد المتاح</th>
                        <th>حد الأمان (الحد الأدنى)</th>
                        <th>سعر التكلفة</th>
                        <th>إجمالي التكلفة</th>
                        <th>حالة المخزون</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            var totalCost = item.TotalStock * item.CostPrice;
                            bool isOutOfStock = item.TotalStock == 0;
                            bool isLowStock = item.TotalStock <= item.MinReorderQuantity && !isOutOfStock;

                            <tr>
                                <td class="fw-bold text-secondary"><code>@item.SKU</code></td>
                                <td class="fw-bold text-start">@item.NameAr</td>
                                <td><span class="badge bg-light text-dark border">@(string.IsNullOrEmpty(item.CategoryName) ? "عام" : item.CategoryName)</span></td>
                                <td class="fw-bold fs-6">@item.TotalStock.ToString("N0") <small class="text-muted">@item.Unit</small></td>
                                <td><span class="badge bg-secondary-subtle text-secondary">@item.MinReorderQuantity.ToString("N0")</span></td>
                                <td>@item.CostPrice.ToString("N2") ج.م</td>
                                <td class="fw-bold text-primary">@totalCost.ToString("N2") ج.م</td>
                                <td>
                                    @if (isOutOfStock)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1"><i class="bi bi-x-circle me-1"></i> نفذ بالكامل</span>
                                    }
                                    else if (isLowStock)
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1"><i class="bi bi-exclamation-triangle me-1"></i> منخفض (تحت حد الأمان)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"><i class="bi bi-check-circle me-1"></i> آمن ومتوفر</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-muted py-4">لا توجد منتجات أومخزون مسجل حالياً.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>