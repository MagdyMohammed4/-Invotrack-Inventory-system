@model IEnumerable<Invotrack.Application.DTOs.LowStockProductDto>
@{
    ViewData["Title"] = "تنبيهات انخفاض المخزون والنواقص";
}

<div class="d-flex justify-content-between align-items-center mb-4" dir="rtl">
    <div>
        <h3 class="fw-bold text-danger mb-0">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>تنبيهات الأصناف النواقص
        </h3>
        <small class="text-muted">الأصناف التي وصلت أو تجاوزت حد إعادة الطلب الأدنى</small>
    </div>
</div>

<div class="card card-custom p-3" dir="rtl">
    <div class="table-responsive">
        <table class="table table-hover align-middle text-center mb-0">
            <thead class="table-light">
                <tr>
                    <th>كود الصنف (SKU)</th>
                    <th>اسم الصنف (عربي)</th>
                    <th>English Name</th>
                    <th>التصنيف</th>
                    <th>الرصيد الحالي</th>
                    <th>حد إعادة الطلب</th>
                    <th>العجز التقديري</th>
                    <th>الإجراء</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.SKU</td>
                            <td class="fw-bold text-dark">@item.NameAr</td>
                            <td class="text-secondary">@item.NameEn</td>
                            <td><span class="badge bg-light text-dark border">@item.CategoryName</span></td>
                            <td><span class="badge bg-danger fs-6">@item.TotalStock @item.Unit</span></td>
                            <td><span class="badge bg-secondary fs-6">@item.MinReorderQuantity @item.Unit</span></td>
                            <td class="text-danger fw-bold">+@item.ShortageQuantity @item.Unit</td>
                            <td>
                                <a asp-controller="Transactions" asp-action="StockIn" class="btn btn-sm btn-success fw-bold shadow-sm">
                                    <i class="bi bi-box-arrow-in-down me-1"></i> عمل إذن توريد
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-success py-4">
                            <i class="bi bi-check-circle fs-3 d-block mb-2"></i>
                            جميع مستويات المخزون آمنة ولا يوجد أصناف وصلت للحد الأدنى.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>