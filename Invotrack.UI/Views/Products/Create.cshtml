@model Invotrack.Application.DTOs.ProductDto
@{
    ViewData["Title"] = "إضافة منتج جديد";
}

<div class="row justify-content-center" dir="rtl">
    <div class="col-md-8">
        <div class="card card-custom p-4 shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold text-dark mb-0"><i class="bi bi-box-seam me-2 text-primary"></i>إضافة منتج جديد</h4>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-right"></i> إلغاء وعودة</a>
            </div>

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="SKU" class="form-label fw-bold">كود الصنف (SKU)</label>
                        <input asp-for="SKU" class="form-control" placeholder="PRD-001"  />
                        <span asp-validation-for="SKU" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CategoryId" class="form-label fw-bold">التصنيف</label>
                        <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories" required>
                            <option value="">-- اختر التصنيف --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="NameAr" class="form-label fw-bold">الاسم بالعربية</label>
                        <input asp-for="NameAr" class="form-control" required />
                        <span asp-validation-for="NameAr" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="NameEn" class="form-label fw-bold">Name (English)</label>
                        <input asp-for="NameEn" class="form-control" required />
                        <span asp-validation-for="NameEn" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label asp-for="Unit" class="form-label fw-bold">وحدة القياس</label>
                        <input asp-for="Unit" class="form-control" placeholder="قطعة / كجم" required />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="CostPrice" class="form-label fw-bold">سعر التكلفة</label>
                        <input asp-for="CostPrice" type="number" step="0.01" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="SalePrice" class="form-label fw-bold">سعر البيع</label>
                        <input asp-for="SalePrice" type="number" step="0.01" class="form-control" required />
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="TotalStock" class="form-label fw-bold">الرصيد الافتتاحي الأول</label>
                        <input asp-for="TotalStock" type="number" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="MinReorderQuantity" class="form-label fw-bold">حد الطلب الأدنى (للتنبيهات)</label>
                        <input asp-for="MinReorderQuantity" type="number" class="form-control" required />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold shadow-sm"><i class="bi bi-save me-1"></i> حفظ المنتج الجديد</button>
            </form>
        </div>
    </div>
</div>