@model Invotrack.Application.DTOs.PagedResultDto<Invotrack.Application.DTOs.ProductDto>
@{
    ViewData["Title"] = "إدارة المنتجات والأصناف";
}

<div class="d-flex justify-content-between align-items-center mb-4" dir="rtl">
    <div>
        <h3 class="fw-bold text-dark mb-0"><i class="bi bi-box-seam-fill me-2 text-primary"></i>إدارة المنتجات والأصناف</h3>
        <small class="text-muted">متابعة أرصدة المخزون والتكلفة وأسعار البيع</small>
    </div>
    <a asp-action="Create" class="btn btn-primary px-3 shadow-sm"><i class="bi bi-plus-lg me-1"></i> إضافة منتج جديد</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" dir="rtl">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card card-custom p-3 mb-4" dir="rtl">
    <form method="get" class="row g-2">
        <div class="col-md-10">
            <input type="text" name="search" class="form-control" placeholder="ابحث بالاسم بالعربي، بالإنجليزي أو SKU..." value="@ViewBag.Search" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-secondary w-100"><i class="bi bi-search"></i> بحث</button>
        </div>
    </form>
</div>

<div class="card card-custom p-3" dir="rtl">
    <div class="table-responsive">
        <table class="table table-hover align-middle text-center mb-0">
            <thead class="table-light">
                <tr>
                    <th>SKU</th>
                    <th>الاسم (عربي)</th>
                    <th>Name (EN)</th>
                    <th>التصنيف</th>
                    <th>سعر التكلفة</th>
                    <th>سعر البيع</th>
                    <th>الرصيد المتاح</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items != null && Model.Items.Any())
                {
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="fw-bold">@item.SKU</td>
                            <td class="fw-bold text-dark">@item.NameAr</td>
                            <td class="text-secondary">@item.NameEn</td>
                            <td><span class="badge bg-light text-dark border">@item.CategoryName</span></td>
                            <td>@item.CostPrice.ToString("N2") ج.م</td>
                            <td>@item.SalePrice.ToString("N2") ج.م</td>
                            <td>
                                <span class="badge @(item.TotalStock <= item.MinReorderQuantity ? "bg-danger" : "bg-success") fs-6">
                                    @item.TotalStock @item.Unit
                                </span>
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning me-1" title="تعديل"><i class="bi bi-pencil"></i></a>

                                <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteProductModal-@item.Id" title="حذف">
                                    <i class="bi bi-trash"></i>
                                </button>

                                <!-- Modal الحذف التفاعلي -->
                                <div class="modal fade" id="deleteProductModal-@item.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content text-start">
                                            <div class="modal-header bg-danger text-white">
                                                <h5 class="modal-title fw-bold m-0">تأكيد حذف المنتج</h5>
                                                <button type="button" class="btn-close btn-close-white ms-0 me-auto" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body text-center py-4">
                                                <p class="fs-5 mb-2">هل أنت تأكد من رغبتك في حذف هذا المنتج؟</p>
                                                <div class="badge bg-light text-dark fs-6 p-2 border">@item.NameAr | SKU: @item.SKU</div>
                                            </div>
                                            <div class="modal-footer justify-content-center">
                                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                                    <button type="submit" class="btn btn-danger px-4 fw-bold">نعم، احذف</button>
                                                </form>
                                                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">إلغاء</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-muted py-4">لا توجد منتجات مسجلة.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pageIndex="@i" asp-route-search="@ViewBag.Search">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>